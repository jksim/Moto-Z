---
import { Image } from 'astro:assets';
import { image as resolve, type Img } from '../lib/images';

interface Props {
  images: Img[];
  name: string;
  exclude?: string;
}
const { images, name, exclude } = Astro.props;
// The hero is shown above, and it is not always the first image.
const shots = images.filter((i) => i.role !== 'logo' && i.key !== exclude);
---
{shots.length > 0 && (
  <div class="gallery">
    {shots.map((img) => {
      const src = resolve(img.key);
      return src ? (
        <Image src={src} alt={`${name} — ${img.role}`} widths={[240, 480, 800]}
               sizes="(max-width: 640px) 90vw, 320px" loading="lazy" />
      ) : null;
    })}
  </div>
)}
