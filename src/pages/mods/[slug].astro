---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpecTable from '../../components/SpecTable.astro';
import FeatureList from '../../components/FeatureList.astro';
import Gallery from '../../components/Gallery.astro';
import Awards from '../../components/Awards.astro';
import { image as resolve, cover } from '../../lib/images';
import { href } from '../../lib/url';
import { categoryLabel } from '../../lib/catalogue';

export async function getStaticPaths() {
  const mods = await getCollection('mods');
  return mods.map((mod) => ({ params: { slug: mod.data.slug }, props: { mod } }));
}

const { mod } = Astro.props;
const d = mod.data;
const heroImg = cover(d.images, d.coverKey);
const hero = heroImg ? resolve(heroImg.key) : undefined;
// Continue the shot's own backdrop behind it so the frame has no visible edge.
const heroStyle = heroImg?.bg ? `background: ${heroImg.bg}` : undefined;

const devices = await Promise.all(
  d.compatibleDevices.map(async (ref) => {
    const entry = await getEntry(ref);
    return entry ? { slug: entry.data.slug, name: entry.data.name } : null;
  }),
);
const works = devices.filter((d): d is { slug: string; name: string } => Boolean(d));
---
<BaseLayout title={`${d.name} — Moto Mods`} description={d.summary || d.tagline}>
  <article>
    <section class="hero wrap">
      <p class="eyebrow">{d.brand} &middot; {categoryLabel(d.category)} &middot; {d.year}</p>
      <h1>{d.name}</h1>
      {d.tagline && <p class="lede">{d.tagline}</p>}
      {hero && (
        <div class="hero-media" style={heroStyle}>
          <Image src={hero} alt={d.name} widths={[480, 800, 1200]}
                 sizes="(max-width: 900px) 100vw, 1100px" loading="eager" fetchpriority="high" />
        </div>
      )}
    </section>

    <section class="wrap section">
      <div class="cols">
        <div>
          {d.summary && <p class="lede">{d.summary}</p>}
          {d.details && <p class="details">{d.details}</p>}
          <FeatureList features={d.features} />
          <Gallery images={d.images} name={d.name} exclude={heroImg?.key} />
        </div>
        <aside>
          <h2>Specifications</h2>
          <SpecTable specs={d.specs} />
        </aside>
      </div>
    </section>

    {d.timeline.length > 0 && (
      <section class="wrap section">
        <h2>How it happened</h2>
        <ol class="timeline">
          {d.timeline.map((t) => (
            <li>
              <span class="timeline-date">{t.date}</span>
              <span class="timeline-event">{t.event}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    <Awards awards={d.awards} />

    <section class="wrap section">
      <h2>Works with</h2>
      {d.fit === 'per-model' && (
        <p class="note">Sold cut for a specific Moto Z model — check the model when buying.</p>
      )}
      <ul class="chips">
        {works.map((p) => (
          <li><a class="chip" href={href(`/phones/${p.slug}/`)}>{p.name}</a></li>
        ))}
      </ul>
      {d.relatedDocs.length > 0 && (
        <p class="note" style="margin-top:1.4rem">
          How it worked: {d.relatedDocs.map((doc, i) => (
            <>{i > 0 && ', '}<a href={doc.url}>{doc.title}</a></>
          ))}
        </p>
      )}
    </section>
  </article>
</BaseLayout>
